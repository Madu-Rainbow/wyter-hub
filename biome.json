{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "*.ts",
      "*.tsx",
      "*.js",
      "*.json",
      "!!**/node_modules",
      "!!**/.next",
      "!!**/dist",
      "!!**/coverage",
      "!!**/drizzle/meta"
    ]
  }
}
